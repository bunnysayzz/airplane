# SPDX-License-Identifier: Apache-2.0
# editorconfig.org
# Matches the repo's prettier config (2-space indent, LF, trailing newline).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
